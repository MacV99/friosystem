<script>
  // @ts-nocheck

  /* ── URL DEL GOOGLE APPS SCRIPT ──────────────────────────────────────
     Pega aquí la URL de tu web app después de publicarla en Apps Script.
     Ejemplo: "https://script.google.com/macros/s/AKfy.../exec"
  ─────────────────────────────────────────────────────────────────── */
  const APPS_SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbzO7TUz_kLC2dQBo4p-su7O0ltJ2NMoX8H7JbXXey6FUwNEe60XOIkw9K4UDbhLmzpX/exec";

  /* ── CONTROL DE ACCESO ── */
  function verificarAcceso() {
    const input = document.getElementById("acceso-password");
    if (input.value === "friosystem123") {
      document.getElementById("acceso-card").style.display = "none";
      document.getElementById("formulario-reporte").style.display = "flex";
      const _hoy = new Date();
      document.getElementById("fecha-servicio").value =
        `${String(_hoy.getDate()).padStart(2, "0")}/${String(_hoy.getMonth() + 1).padStart(2, "0")}/${_hoy.getFullYear()}`;
    } else {
      fsrToast("Contraseña incorrecta", "🔒");
      input.value = "";
      input.focus();
    }
  }

  /* ── TOAST ── */
  let fsrToastTimer;
  function fsrToast(msg, icono = "🔔") {
    clearTimeout(fsrToastTimer);
    const t = document.getElementById("fsr-toast");
    document.getElementById("fsr-toast-icon").textContent = icono;
    document.getElementById("fsr-toast-msg").textContent = msg;
    t.classList.add("fs-toast-visible");
    fsrToastTimer = setTimeout(
      () => t.classList.remove("fs-toast-visible"),
      3200,
    );
  }

  /* ── MODAL ── */
  const FSR_VARIANTES = {
    aviso: { emoji: "💡", clase: "fs-icon-aviso" },
    error: { emoji: "❌", clase: "fs-icon-error" },
    exito: { emoji: "✅", clase: "fs-icon-exito" },
  };

  function fsrModalShow({ title, body, variante = "aviso" }) {
    const v = FSR_VARIANTES[variante] || FSR_VARIANTES.aviso;
    const iconEl = document.getElementById("fsr-modal-icon");
    iconEl.textContent = v.emoji;
    iconEl.className = "fs-modal-icon flex-row " + v.clase;
    document.getElementById("fsr-modal-title").textContent = title;
    document.getElementById("fsr-modal-body").innerHTML = body;
    document.getElementById("fsr-modal").classList.add("fs-modal-visible");
  }

  function fsrModalHide() {
    document.getElementById("fsr-modal").classList.remove("fs-modal-visible");
  }

  document.getElementById("fsr-modal-ok").onclick = fsrModalHide;
  document.getElementById("fsr-modal-close").onclick = fsrModalHide;
  document.getElementById("fsr-modal").addEventListener("click", function (e) {
    if (e.target === this) fsrModalHide();
  });

  /* ── BOTÓN: estados visuales ── */
  function setBtnEstado(estado) {
    const btn = document.getElementById("btn-generar");
    const icono = document.getElementById("btn-icon");
    const texto = document.getElementById("btn-texto");

    const estados = {
      normal: {
        icon: "bi-cloud-upload",
        txt: "Guardar Reporte",
        disabled: false,
      },
      cargando: {
        icon: "bi-hourglass-split",
        txt: "Guardando...",
        disabled: true,
      },
      exito: { icon: "bi-check-circle", txt: "¡Guardado!", disabled: true },
    };

    const e = estados[estado] || estados.normal;
    icono.className = `bi ${e.icon}`;
    texto.textContent = e.txt;
    btn.disabled = e.disabled;
  }

  /* ── FOTO: comprimir y previsualizar ── */
  let fotoBase64 = null;

  async function comprimirImagen(file, maxWidth = 1280, calidad = 0.78) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement("canvas");
          let w = img.width;
          let h = img.height;
          if (w > maxWidth) {
            h = Math.round((h * maxWidth) / w);
            w = maxWidth;
          }
          canvas.width = w;
          canvas.height = h;
          canvas.getContext("2d").drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL("image/jpeg", calidad));
        };
        img.onerror = reject;
        img.src = e.target.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  async function previsualizarFoto(input) {
    const file = input.files[0];
    if (!file) return;
    fsrToast("Procesando imagen...", "🖼️");
    try {
      fotoBase64 = await comprimirImagen(file);
      const preview = document.getElementById("foto-preview");
      const placeholder = document.getElementById("foto-placeholder");
      const area = document.getElementById("foto-upload-area");
      const info = document.getElementById("foto-info");
      preview.src = fotoBase64;
      preview.style.display = "block";
      placeholder.style.display = "none";
      area.classList.add("tiene-foto");
      const sizeKB = Math.round((fotoBase64.length * 0.75) / 1024);
      info.textContent = `${file.name}  ·  ${sizeKB} KB`;
      info.style.display = "block";
      fsrToast("Foto lista", "✅");
    } catch {
      fsrToast("Error al procesar la imagen", "❌");
    }
  }

  /* ── FIRMA: panel de dibujo ──────────────────────────────────────
     Los trazos se guardan como listas de puntos (no como píxeles), así
     se pueden deshacer, redibujar al girar el teléfono y exportar
     recortados y nítidos sin importar el tamaño de la pantalla.
  ──────────────────────────────────────────────────────────────── */
  const FIRMA_TINTA = "#0a1a2f";
  const FIRMA_GROSOR = 2.6;

  let firmaBase64 = null; // imagen final que viaja con el reporte
  let firmaGuardada = []; // trazos de la firma aceptada (para "Cambiar")
  let firmaTrazos = []; // trazos en edición dentro del panel
  let firmaTrazoActual = null;
  let firmaAncho = 0;
  let firmaAlto = 0;

  const firmaPanel = document.getElementById("firma-panel");
  const firmaLienzo = document.getElementById("firma-lienzo");
  const firmaCtx = firmaLienzo.getContext("2d");

  function firmaPintarTrazos(ctx, trazos, escala, dx, dy) {
    ctx.strokeStyle = FIRMA_TINTA;
    ctx.fillStyle = FIRMA_TINTA;
    ctx.lineWidth = FIRMA_GROSOR * escala;
    ctx.lineCap = "round";
    ctx.lineJoin = "round";
    for (const t of trazos) {
      const p = t.map(([x, y]) => [(x - dx) * escala, (y - dy) * escala]);
      if (p.length === 1) {
        // Un toque sin arrastrar: se dibuja un punto.
        ctx.beginPath();
        ctx.arc(p[0][0], p[0][1], (FIRMA_GROSOR * escala) / 2, 0, Math.PI * 2);
        ctx.fill();
        continue;
      }
      // Curvas entre puntos medios: la línea sale suave, no quebrada.
      ctx.beginPath();
      ctx.moveTo(p[0][0], p[0][1]);
      for (let i = 1; i < p.length - 1; i++) {
        const mx = (p[i][0] + p[i + 1][0]) / 2;
        const my = (p[i][1] + p[i + 1][1]) / 2;
        ctx.quadraticCurveTo(p[i][0], p[i][1], mx, my);
      }
      const u = p[p.length - 1];
      ctx.lineTo(u[0], u[1]);
      ctx.stroke();
    }
  }

  function firmaRedibujar() {
    const dpr = window.devicePixelRatio || 1;
    firmaCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    firmaCtx.clearRect(0, 0, firmaAncho, firmaAlto);
    firmaPintarTrazos(firmaCtx, firmaTrazos, 1, 0, 0);
    const vacio = firmaTrazos.length === 0;
    document.getElementById("firma-guia").classList.toggle("firma-oculta", !vacio);
    document.getElementById("firma-borrar").disabled = vacio;
    document.getElementById("firma-deshacer").disabled = vacio;
    document.getElementById("firma-aceptar").disabled = vacio;
  }

  /* Ajusta el lienzo al tamaño real en pantalla. Si cambió (giro del
     teléfono), reacomoda lo ya dibujado para que no se pierda. */
  function firmaAjustarLienzo() {
    const r = firmaLienzo.getBoundingClientRect();
    if (!r.width || !r.height) return;
    if (firmaAncho && (r.width !== firmaAncho || r.height !== firmaAlto)) {
      const s = Math.min(r.width / firmaAncho, r.height / firmaAlto);
      const ox = (r.width - firmaAncho * s) / 2;
      const oy = (r.height - firmaAlto * s) / 2;
      firmaTrazos = firmaTrazos.map((t) =>
        t.map(([x, y]) => [x * s + ox, y * s + oy]),
      );
    }
    firmaAncho = r.width;
    firmaAlto = r.height;
    const dpr = window.devicePixelRatio || 1;
    firmaLienzo.width = Math.round(r.width * dpr);
    firmaLienzo.height = Math.round(r.height * dpr);
    firmaRedibujar();
  }

  function firmaPunto(e) {
    const r = firmaLienzo.getBoundingClientRect();
    return [e.clientX - r.left, e.clientY - r.top];
  }

  firmaLienzo.addEventListener("pointerdown", (e) => {
    if (e.button !== undefined && e.button > 0) return;
    e.preventDefault();
    firmaLienzo.setPointerCapture(e.pointerId);
    firmaTrazoActual = [firmaPunto(e)];
    firmaTrazos.push(firmaTrazoActual);
    firmaRedibujar();
  });

  firmaLienzo.addEventListener("pointermove", (e) => {
    if (!firmaTrazoActual) return;
    e.preventDefault();
    // getCoalescedEvents da todos los puntos intermedios → trazo más fiel.
    const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [];
    for (const ev of evs.length ? evs : [e]) {
      const pt = firmaPunto(ev);
      const ult = firmaTrazoActual[firmaTrazoActual.length - 1];
      if (Math.hypot(pt[0] - ult[0], pt[1] - ult[1]) >= 1.2) {
        firmaTrazoActual.push(pt);
      }
    }
    firmaRedibujar();
  });

  const firmaSoltar = () => {
    firmaTrazoActual = null;
  };
  firmaLienzo.addEventListener("pointerup", firmaSoltar);
  firmaLienzo.addEventListener("pointercancel", firmaSoltar);

  /* Devuelve la firma recortada a su contorno, sobre fondo blanco. */
  function firmaExportar() {
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    for (const t of firmaTrazos) {
      for (const [x, y] of t) {
        if (x < x0) x0 = x;
        if (y < y0) y0 = y;
        if (x > x1) x1 = x;
        if (y > y1) y1 = y;
      }
    }
    const margen = 14;
    x0 -= margen;
    y0 -= margen;
    const w = x1 - x0 + margen;
    const h = y1 - y0 + margen;
    // Tamaño fijo de salida: nítida en el documento y liviana para enviar.
    const escala = Math.min(700 / w, 320 / h, 3);
    const c = document.createElement("canvas");
    c.width = Math.max(1, Math.round(w * escala));
    c.height = Math.max(1, Math.round(h * escala));
    const ctx = c.getContext("2d");
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, c.width, c.height);
    firmaPintarTrazos(ctx, firmaTrazos, escala, x0, y0);
    return c.toDataURL("image/png");
  }

  function firmaAbrir() {
    const nombre =
      document.getElementById("funcionario").value.trim() ||
      document.getElementById("cliente").value.trim();
    document.getElementById("firma-nombre").textContent = nombre
      ? `Firma: ${nombre}`
      : "Firme dentro del recuadro";
    firmaTrazos = firmaGuardada.map((t) => t.map((p) => [...p]));
    firmaTrazoActual = null;
    firmaAncho = firmaGuardada.ancho || 0;
    firmaAlto = firmaGuardada.alto || 0;
    firmaPanel.classList.add("firma-visible");
    firmaPanel.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    requestAnimationFrame(firmaAjustarLienzo);
  }

  function firmaCerrar() {
    firmaPanel.classList.remove("firma-visible");
    firmaPanel.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    firmaTrazoActual = null;
  }

  function firmaMostrarEnFormulario() {
    const tiene = !!firmaBase64;
    const img = document.getElementById("firma-preview");
    if (tiene) img.src = firmaBase64;
    img.style.display = tiene ? "block" : "none";
    document.getElementById("firma-vacia").style.display = tiene ? "none" : "flex";
    document.getElementById("firma-acciones").style.display = tiene ? "flex" : "none";
    document.getElementById("firma-caja").classList.toggle("tiene-firma", tiene);
  }

  function firmaAceptar() {
    if (!firmaTrazos.length) return;
    firmaBase64 = firmaExportar();
    firmaGuardada = firmaTrazos;
    firmaGuardada.ancho = firmaAncho;
    firmaGuardada.alto = firmaAlto;
    firmaMostrarEnFormulario();
    firmaCerrar();
    fsrToast("Firma lista", "✅");
  }

  function firmaQuitar() {
    firmaBase64 = null;
    firmaGuardada = [];
    firmaMostrarEnFormulario();
  }

  document.getElementById("firma-caja").addEventListener("click", firmaAbrir);
  document.getElementById("firma-cambiar").addEventListener("click", () => {
    firmaGuardada = [];
    firmaAbrir();
  });
  document.getElementById("firma-quitar").addEventListener("click", firmaQuitar);
  document.getElementById("firma-cerrar").addEventListener("click", firmaCerrar);
  document.getElementById("firma-aceptar").addEventListener("click", firmaAceptar);
  document.getElementById("firma-borrar").addEventListener("click", () => {
    firmaTrazos = [];
    firmaRedibujar();
  });
  document.getElementById("firma-deshacer").addEventListener("click", () => {
    firmaTrazos.pop();
    firmaRedibujar();
  });
  firmaPanel.addEventListener("click", (e) => {
    if (e.target === firmaPanel) firmaCerrar();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && firmaPanel.classList.contains("firma-visible")) {
      firmaCerrar();
    }
  });
  window.addEventListener("resize", () => {
    if (firmaPanel.classList.contains("firma-visible")) firmaAjustarLienzo();
  });

  /* ── LIMPIAR FORMULARIO ── */
  function limpiarFormulario() {
    document
      .querySelectorAll(
        "#formulario-reporte input:not(#foto-input), #formulario-reporte textarea, #formulario-reporte select",
      )
      .forEach((el) => {
        if (el.tagName === "SELECT") {
          el.selectedIndex = 0;
        } else {
          el.value = "";
        }
      });
    // Resetear foto
    fotoBase64 = null;
    document.getElementById("foto-camera-input").value = "";
    document.getElementById("foto-gallery-input").value = "";
    document.getElementById("foto-preview").style.display = "none";
    document.getElementById("foto-placeholder").style.display = "flex";
    document.getElementById("foto-upload-area").classList.remove("tiene-foto");
    document.getElementById("foto-info").style.display = "none";
    // Resetear firma
    firmaQuitar();
  }

  /* ── ENVIAR REPORTE ── */
  async function enviarReporte() {
    const v = (id) => document.getElementById(id)?.value.trim() ?? "";

    const datos = {
      cedula: v("cedula"),
      cliente: v("cliente"),
      zona: v("zona"),
      ciudad: v("ciudad"),
      tipoEquipo: v("tipo-equipo"),
      marca: v("marca"),
      inventario: v("inventario"),
      tipoServicio: v("tipo-servicio"),
      capacidad: v("capacidad"),
      l1: v("l1"),
      l2: v("l2"),
      l3: v("l3"),
      succion: v("succion"),
      descP: v("desc-p"),
      voltaje: v("voltaje"),
      tSum: v("t-sum"),
      tRet: v("t-ret"),
      tAmb: v("t-amb"),
      descripcion: v("descripcion"),
      material: v("material"),
      funcionario: v("funcionario"),
      telefono: v("telefono"),
      foto: fotoBase64 ?? "",
      firma: firmaBase64 ?? "",
      calificacion: v("calificacion"),
      tecnico: v("tecnico"),
      observacion: v("observacion"),
      fecha: v("fecha-servicio"),
    };

    /* Validación de campos obligatorios */
    if (!datos.cedula) {
      fsrToast("Ingresa la cédula / NIT del cliente", "⚠️");
      document.getElementById("cedula").focus();
      return;
    }
    if (!datos.cliente) {
      fsrToast("Ingresa el nombre del cliente", "⚠️");
      document.getElementById("cliente").focus();
      return;
    }
    if (!datos.tecnico) {
      fsrToast("Ingresa el nombre del técnico", "⚠️");
      document.getElementById("tecnico").focus();
      return;
    }
    if (!APPS_SCRIPT_URL) {
      fsrToast("URL de Apps Script no configurada", "⚙️");
      return;
    }

    setBtnEstado("cargando");
    fsrToast("Guardando reporte...", "⏳");

    try {
      /* text/plain = simple request → sin preflight CORS.
         Apps Script debe responder JSON con { ok: true } o { ok: false, error }. */
      const res = await fetch(APPS_SCRIPT_URL, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify(datos),
        redirect: "follow",
      });

      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }

      const json = await res.json().catch(() => ({ ok: false, error: "Respuesta no es JSON" }));
      if (!json.ok) {
        throw new Error(json.error || "Apps Script reportó fallo");
      }

      setBtnEstado("exito");
      fsrToast("¡Reporte guardado!", "✅");

      setTimeout(() => {
        fsrModalShow({
          title: "Reporte guardado",
          body: `El reporte de <strong>${datos.cliente}</strong> fue registrado correctamente.<br><small style="color:#888">Cédula/NIT: ${datos.cedula} · Técnico: ${datos.tecnico}</small>`,
          variante: "exito",
        });
        setBtnEstado("normal");
        limpiarFormulario();
      }, 800);
    } catch (err) {
      console.error("Error guardando reporte:", err);
      setBtnEstado("normal");
      fsrToast("Error al guardar el reporte", "❌");
      setTimeout(() => {
        fsrModalShow({
          title: "Error al guardar",
          body: `No se pudo guardar el reporte.<br><small style="color:#888">${err?.message ?? err}</small>`,
          variante: "error",
        });
      }, 400);
    }
  }

  /* ── CONECTAR ZONA DE FOTO ── */
  const fotoCameraInput = document.getElementById("foto-camera-input");
  const fotoGalleryInput = document.getElementById("foto-gallery-input");
  document.getElementById("btn-camara").addEventListener("click", () => fotoCameraInput.click());
  document.getElementById("btn-galeria").addEventListener("click", () => fotoGalleryInput.click());
  fotoCameraInput.addEventListener("change", () => previsualizarFoto(fotoCameraInput));
  fotoGalleryInput.addEventListener("change", () => previsualizarFoto(fotoGalleryInput));

  window.verificarAcceso = verificarAcceso;
  window.enviarReporte = enviarReporte;
</script>
