<section id="nosotros">
  <div class="nos-grid">
    <div class="nos-text">
      <span class="nos-badge">
        <i class="bi bi-geo-alt-fill"></i>
        Empresa Huilense · Desde 2011
      </span>

      <h2>QUIÉNES<br />SOMOS</h2>

      <div class="nos-body">
        <p>
          Somos especialistas en diseño, consultoría, suministro, instalación y
          mantenimiento de sistemas de aire acondicionado, ventilación mecánica
          y refrigeración, desarrollando proyectos integrales con altos
          estándares técnicos, respaldo profesional y enfoque en ahorro
          energético.
        </p>
        <p>
          No solo instalamos equipos: diseñamos soluciones inteligentes que
          optimizan el rendimiento, prolongan la vida útil de sus sistemas y
          garantizan ambientes más seguros, confortables y eficientes.
        </p>
        <p>
          Contamos con personal altamente calificado — Ingenieros de Proyectos,
          Coordinadores de Alturas, Técnicos HVAC y Electricistas con Matrícula
          CONTÉ — para dar apoyo a las necesidades de nuestros clientes en sus
          proyectos y montajes.
        </p>
        <p>
          Trabajamos con tecnología de alto nivel, marcas reconocidas y un
          equipo técnico comprometido con resultados que superan expectativas y
          generan verdadera tranquilidad operativa.
        </p>
      </div>

      <p class="nos-slogan">
        <strong>AC FRIOSYSTEM SAS</strong><br />
        Ingeniería que enfría, eficiencia que perdura.
      </p>
    </div>

    <div class="nos-visual" id="nosSlider">
      <div class="slider-track">
        <img src="/img/general/ind (1).avif" alt="AC Friosystem instalación 1" class="slide active" />
        <img src="/img/general/ind (2).avif" alt="AC Friosystem instalación 2" class="slide" />
        <img src="/img/general/ind (3).avif" alt="AC Friosystem instalación 3" class="slide" />
        <img src="/img/general/ind (4).avif" alt="AC Friosystem instalación 4" class="slide" />
        <img src="/img/general/ind (5).avif" alt="AC Friosystem instalación 5" class="slide" />
        <img src="/img/general/ind (6).avif" alt="AC Friosystem instalación 6" class="slide" />
        <img src="/img/general/ind (7).avif" alt="AC Friosystem instalación 7" class="slide" />
        <img src="/img/general/ind (8).avif" alt="AC Friosystem instalación 8" class="slide" />
        <img src="/img/general/ind (9).avif" alt="AC Friosystem instalación 9" class="slide" />
      </div>

      <div class="nos-overlay-badge">
        <i class="bi bi-people-fill"></i>
        <span>Equipo altamente calificado</span>
      </div>

      <div class="slider-dots" id="nosDots"></div>
    </div>

    <script>
      (function () {
        const slider = document.getElementById("nosSlider");
        if (!slider) return;
        const slides = slider.querySelectorAll(".slide");
        const dotsContainer = slider.querySelector("#nosDots");
        let current = 0;
        let timer;

        slides.forEach((_, i) => {
          const d = document.createElement("button");
          d.className = "dot" + (i === 0 ? " dot-active" : "");
          d.setAttribute("aria-label", `Foto ${i + 1}`);
          d.addEventListener("click", () => goTo(i));
          dotsContainer.appendChild(d);
        });

        function goTo(n) {
          slides[current].classList.remove("active");
          dotsContainer.children[current].classList.remove("dot-active");
          current = (n + slides.length) % slides.length;
          slides[current].classList.add("active");
          dotsContainer.children[current].classList.add("dot-active");
        }

        function start() {
          timer = setInterval(() => goTo(current + 1), 4000);
        }

        function stop() {
          clearInterval(timer);
        }

        slider.addEventListener("mouseenter", stop);
        slider.addEventListener("mouseleave", start);
        start();
      })();
    </script>
  </div>
</section>

